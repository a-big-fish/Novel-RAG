# Application
APP_ENV=development
APP_VERSION=0.9.0
API_PREFIX=/api/v1

# Source and data paths
BOOK_SOURCE_DIR=./data/books
ALLOWED_SOURCE_ROOTS=./data/books
BOOK_UPLOAD_MAX_BYTES=104857600
DATA_BOOKS_DIR=./data/books
DATA_CONVERTED_DIR=./data/converted
EPUB_CONVERTER_VERSION=epub-v1

# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Local default: observation database with the four indexed demo books.
POSTGRES_DB=novel_rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=
POSTGRES_TEST_DB=novel_rag_test

# Qdrant
QDRANT_URL=http://127.0.0.1:6333

# Ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_RERANK_MODEL=awenleven/Qwen3-Reranker-4B:Q4_K_M

# LLM adapter: openai_compatible | codex_exec
LLM_ADAPTER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=1.0

# Codex exec adapter
CODEX_EXEC_PATH=codex
CODEX_EXEC_TIMEOUT_SECONDS=1800

# Bounded model input
LONG_TEXT_HEAD_CHARS=1200
LONG_TEXT_MIDDLE_CHARS=1200
LONG_TEXT_TAIL_CHARS=1200
MAX_LLM_INPUT_CHARS=3600
SCENE_MIN_CHARS=1200
MAX_EMBED_INPUT_CHARS=3600

# Tag vocabulary
TAG_VOCAB_VERSION=v1
REFERENCE_RULE_VERSION=v1

# Single-book retrieval
QUERY_PROMPT_VERSION=v1
QUERY_MAX_CHARS=2000
QUERY_ROUTE_TOP_N=20
QUERY_RRF_TOP_N=20
RRF_K=60

# Fast query parsing (no long reasoning; fail fast and cache the fallback)
QUERY_LLM_MODEL=
QUERY_LLM_TEMPERATURE=0
QUERY_LLM_MAX_TOKENS=400
# Leave empty to omit reasoning_effort entirely (fastest; some providers
# interpret "minimal" as enabling a reasoning pass and may exhaust the budget).
QUERY_LLM_REASONING_EFFORT=
QUERY_LLM_TIMEOUT_SECONDS=45
QUERY_LLM_MAX_RETRIES=0
QUERY_LLM_JSON_RESPONSE_FORMAT=true
QUERY_FALLBACK_CACHE_SECONDS=21600

# Multi-book retrieval and optional global rerank
MULTI_SEARCH_MAX_BOOKS=20
MULTI_SEARCH_CONCURRENCY=4
MULTI_SEARCH_ATTEMPTS=2
MULTI_SEARCH_PER_BOOK_LIMIT=20
MULTI_SEARCH_GLOBAL_LIMIT=50
# Reloaded from this file before each multi-book search; true or false.
RERANK_ENABLED=false
RERANK_TOP_N=10
RERANK_CONCURRENCY=1
RERANK_TIMEOUT_SECONDS=180
RERANK_MAX_DOCUMENT_CHARS=3600

# Prompt assembly (used by /assemble and the MCP server)
ASSEMBLY_BUDGET_CHARS=6000
ASSEMBLY_MAX_SCENES=8
ASSEMBLY_PER_SCENE_CHARS=1200
# 0 disables the per-book quota
ASSEMBLY_BOOK_QUOTA=0
ASSEMBLY_TEMPLATE_VERSION=assembly-v1

# stdio MCP server identity
MCP_SERVER_NAME=novel-rag

# In-process index worker (PostgreSQL queue + lease + checkpoint; no middleware)
# Enable this for uvicorn to process queued index jobs automatically.
INDEX_WORKER_ENABLED=true
INDEX_WORKER_POLL_SECONDS=5
INDEX_WORKER_HEARTBEAT_SECONDS=30
INDEX_WORKER_LEASE_SECONDS=180
INDEX_JOB_MAX_ATTEMPTS=3
INDEX_JOB_RETRY_BACKOFF_SECONDS=30
INDEX_JOB_RETRY_MAX_SECONDS=900
