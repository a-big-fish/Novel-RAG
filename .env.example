# Application
APP_ENV=development
APP_VERSION=0.7.0
API_PREFIX=/api/v1

# Source and data paths
BOOK_SOURCE_DIR=E:/novels/tool
ALLOWED_SOURCE_ROOTS=E:/novels/tool
DATA_BOOKS_DIR=E:/novels/novel-rag/data/books
DATA_CONVERTED_DIR=E:/novels/novel-rag/data/converted
EPUB_CONVERTER_VERSION=epub-v1

# PostgreSQL
POSTGRES_HOST=172.16.43.125
POSTGRES_PORT=5432
POSTGRES_DB=novel_rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=
POSTGRES_TEST_DB=novel-rag-test-2

# Qdrant
QDRANT_URL=http://172.16.43.125:6333

# Ollama
OLLAMA_URL=http://172.16.43.125:11434
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_RERANK_MODEL=awenleven/Qwen3-Reranker-4B:Q4_K_M

# LLM adapter: openai_compatible | codex_exec
LLM_ADAPTER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=1.0

# Codex exec adapter
CODEX_EXEC_PATH=codex
CODEX_EXEC_TIMEOUT_SECONDS=1800

# Bounded model input
LONG_TEXT_HEAD_CHARS=1200
LONG_TEXT_MIDDLE_CHARS=1200
LONG_TEXT_TAIL_CHARS=1200
MAX_LLM_INPUT_CHARS=3600
MAX_EMBED_INPUT_CHARS=3600

# Tag vocabulary
TAG_VOCAB_VERSION=v1
REFERENCE_RULE_VERSION=v1

# Single-book retrieval
QUERY_PROMPT_VERSION=v1
QUERY_MAX_CHARS=2000
QUERY_ROUTE_TOP_N=20
QUERY_RRF_TOP_N=20
RRF_K=60

# Multi-book retrieval and optional global rerank
MULTI_SEARCH_MAX_BOOKS=20
MULTI_SEARCH_CONCURRENCY=4
MULTI_SEARCH_ATTEMPTS=2
MULTI_SEARCH_PER_BOOK_LIMIT=20
MULTI_SEARCH_GLOBAL_LIMIT=50
RERANK_ENABLED=false
RERANK_TOP_N=10
RERANK_CONCURRENCY=2
RERANK_TIMEOUT_SECONDS=60
RERANK_MAX_DOCUMENT_CHARS=3600
